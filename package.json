{
  "name": "patrimoine-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:apercu": "VITE_HASH=1 vite build --base ./ --outDir dist-apercu",
    "preview": "vite preview",
    "test": "vitest run",
    "sources:check": "tsx scripts/watch-sources.ts",
    "sources:accept": "tsx scripts/watch-sources.ts --accept",
    "review:check": "tsx scripts/check-reviews.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
