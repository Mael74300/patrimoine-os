{
  "name": "patrimoine-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/seo-check.mjs",
    "build:apercu": "VITE_HASH=1 vite build --base ./ --outDir dist-apercu",
    "preview": "vite preview",
    "seo:check": "node scripts/seo-check.mjs",
    "test": "vitest run",
    "sources:check": "tsx scripts/watch-sources.ts",
    "sources:accept": "tsx scripts/watch-sources.ts --accept",
    "review:check": "tsx scripts/check-reviews.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
